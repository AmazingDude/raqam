{
  "name": "raqam",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "smoke:platform": "node scripts/smoke-platform.mjs",
    "smoke:live": "node --env-file-if-exists=.env.local scripts/smoke-live.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test --test-isolation=none tests/backend/*.test.ts tests/security/*.test.ts",
    "test:ai:live": "node --env-file-if-exists=.env.local --import tsx tests/ai/live/feasibility.ts",
    "check:env": "node --env-file-if-exists=.env.local scripts/check-env.mjs",
    "check:services": "node --env-file-if-exists=.env.local scripts/check-services.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "7.9.13",
    "@supabase/supabase-js": "2.117.3",
    "groq-sdk": "1.6.0",
    "next": "16.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "25.9.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "supabase": "2.120.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
